# Copy this file to .deploy/.env.deploy and fill in the FTP password.
FTP_PROTOCOL=ftps
FTP_TLS_VERIFY=true
FTP_HOST='ftp.teatromuseo.cl'
FTP_PORT=21
FTP_USER=''
FTP_PASS=''
FTP_REMOTE_DIR=''

# Optional post-deploy smoke test. Leave empty to skip it.
DEPLOY_HEALTHCHECK_URL=
DEPLOY_HEALTHCHECK_TIMEOUT=20
