#--------------------------------------------------------------------
# Example Environment Configuration File — BFF Starter
#
# Copy this file to .env and customize. NEVER commit .env to git.
#
# Command: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8188'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key = ""

#--------------------------------------------------------------------
# BFF COORDINATES
#
# The BFF is a stateless gateway. It does not store users, does not
# validate JWTs, and does not own any database. It forwards the
# Authorization header from the client to the hub and/or domain on
# every request; both backends validate the token independently.
#--------------------------------------------------------------------

# Base URL of the upstream hub (ci4-api-starter), no trailing slash.
bff.hubUrl = 'http://localhost:8180'

# Base URL of an upstream domain app (ci4-domain-starter), no trailing slash.
# Leave empty if the BFF only fronts the hub.
bff.domainUrl = 'http://localhost:8190'

# Comma-separated list of origins permitted by CORS. In production the
# list MUST be non-empty — Config\Bff throws otherwise to prevent
# accidentally wide-open access.
BFF_ALLOWED_ORIGINS = 'http://localhost:3000,http://localhost:5173'

# Whether CORS responses include Access-Control-Allow-Credentials. Set to
# true if the SPA sends cookies; usually false for token-based clients.
CORS_SUPPORTS_CREDENTIALS = false

#--------------------------------------------------------------------
# HUB SERVICE TOKEN (optional, used only for M2M / setup calls)
#
# The BFF can optionally identify itself to the hub as a registered
# application to obtain a service token (for admin/bootstrap calls).
# For the normal request-forwarding flow none of this is needed.
#--------------------------------------------------------------------

# `hub.url` is accepted as a legacy fallback for `bff.hubUrl` (above).
# Setting one is enough — both `Config\Bff` and `Config\Hub` resolve to the
# same value via `Config\Bff::resolveHubUrl()`. Prefer `bff.hubUrl`.
# hub.url     = 'http://localhost:8180'

# X-App-Key created from the hub via `php spark apps:bootstrap <code>`.
hub.apiKey  = ''
hub.appCode = 'example-bff'

# Cache TTL (seconds) for /auth/introspect responses if the BFF ever
# upgrades to opt-in token introspection. Not used by the default
# forward-only flow.
hub.introspectCacheTtl = 60

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------

RATE_LIMIT_REQUESTS = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_USER_REQUESTS = 100

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

LOG_LEVEL  = debug
LOG_FORMAT = json

#--------------------------------------------------------------------
# MAINTENANCE
#--------------------------------------------------------------------

MAINTENANCE_MODE        = false
MAINTENANCE_RETRY_AFTER = 60
