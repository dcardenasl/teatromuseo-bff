#--------------------------------------------------------------------
# Example Environment Configuration File — BFF Starter
#
# Copy this file to .env and customize. NEVER commit .env to git.
#
# Command: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8188'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key = ""

#--------------------------------------------------------------------
# BFF COORDINATES
#
# The BFF is a stateless gateway. It does not store users, does not
# validate JWTs, and does not own a write database. Public-read routes use
# four explicit read-only MySQL connections and never issue mutations.
#--------------------------------------------------------------------

# Base URL of the upstream hub (ci4-api-starter), no trailing slash.
bff.hubUrl = 'http://localhost:8180'

# Base URLs of upstream domain apps (ci4-domain-starter), no trailing slash.
# Keys match Config\\Bff::$domains and Services::domainClient().
BFF_DOMAINS = 'cms:http://localhost:8190,catalog:http://localhost:8191,event:http://localhost:8193'

# Application key accepted by the BFF's public-read endpoints. Register this
# key as a web application key in the Hub. Never commit the real value.
BFF_API_KEY = 'CHANGE_ME'

# Public media base URL used when Hub file rows contain relative paths.
HUB_PUBLIC_BASE_URL = 'http://localhost:8180'

# Locale used when a requested translation is unavailable.
PUBLIC_READ_FALLBACK_LOCALE = 'es'

# Must match the CMS/Admin preview secret. Leave empty to fail closed and
# serve only published pages.
CMS_PREVIEW_SECRET = ''

#--------------------------------------------------------------------
# PUBLIC-READ DATABASES (REQUIRED FOR /api/v1/public-read)
#
# Use dedicated MySQL users granted SELECT only on the corresponding schema.
# Keep credentials in the deployment secret store or .env, never in git.
#--------------------------------------------------------------------

CMS_READONLY_DB_HOSTNAME = '127.0.0.1'
CMS_READONLY_DB_PORT = 3306
CMS_READONLY_DB_DATABASE = 'teatromuseo_cms_domain'
CMS_READONLY_DB_USERNAME = 'teatromuseo_cms_ro'
CMS_READONLY_DB_PASSWORD = 'CHANGE_ME'

CATALOG_READONLY_DB_HOSTNAME = '127.0.0.1'
CATALOG_READONLY_DB_PORT = 3306
CATALOG_READONLY_DB_DATABASE = 'teatromuseo_catalog_domain'
CATALOG_READONLY_DB_USERNAME = 'teatromuseo_catalog_ro'
CATALOG_READONLY_DB_PASSWORD = 'CHANGE_ME'

EVENT_READONLY_DB_HOSTNAME = '127.0.0.1'
EVENT_READONLY_DB_PORT = 3306
EVENT_READONLY_DB_DATABASE = 'teatromuseo_event_domain'
EVENT_READONLY_DB_USERNAME = 'teatromuseo_event_ro'
EVENT_READONLY_DB_PASSWORD = 'CHANGE_ME'

HUB_READONLY_DB_HOSTNAME = '127.0.0.1'
HUB_READONLY_DB_PORT = 3306
HUB_READONLY_DB_DATABASE = 'teatromuseo_api'
HUB_READONLY_DB_USERNAME = 'teatromuseo_hub_files_ro'
HUB_READONLY_DB_PASSWORD = 'CHANGE_ME'

# Comma-separated list of origins permitted by CORS. In production the
# list MUST be non-empty — Config\Bff throws otherwise to prevent
# accidentally wide-open access. Never set this to '*' together with
# CORS_SUPPORTS_CREDENTIALS=true — Config\Cors throws in every environment
# for that combination, since it would let any site read authenticated
# responses on the visitor's behalf.
BFF_ALLOWED_ORIGINS = 'http://localhost:3000,http://localhost:5173'

# Whether CORS responses include Access-Control-Allow-Credentials. Set to
# true if the SPA sends cookies; usually false for token-based clients.
# See the BFF_ALLOWED_ORIGINS note above before combining this with '*'.
CORS_SUPPORTS_CREDENTIALS = false

#--------------------------------------------------------------------
# HUB SERVICE TOKEN (optional, used only for M2M / setup calls)
#
# The BFF can optionally identify itself to the hub as a registered
# application to obtain a service token (for admin/bootstrap calls).
# For the normal request-forwarding flow none of this is needed.
#--------------------------------------------------------------------

# `hub.url` is accepted as a legacy fallback for `bff.hubUrl` (above).
# Setting one is enough — both `Config\Bff` and `Config\Hub` resolve to the
# same value via `Config\Bff::resolveHubUrl()`. Prefer `bff.hubUrl`.
# hub.url     = 'http://localhost:8180'

# X-App-Key created from the hub via `php spark apps:bootstrap <code>`.
hub.apiKey  = ''
hub.appCode = 'example-bff'

# Cache TTL (seconds) for /auth/introspect responses if the BFF ever
# upgrades to opt-in token introspection. Not used by the default
# forward-only flow.
hub.introspectCacheTtl = 60

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------

RATE_LIMIT_REQUESTS = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_USER_REQUESTS = 100

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

LOG_LEVEL  = debug
LOG_FORMAT = json

#--------------------------------------------------------------------
# MAINTENANCE
#--------------------------------------------------------------------

MAINTENANCE_MODE        = false
MAINTENANCE_RETRY_AFTER = 60
