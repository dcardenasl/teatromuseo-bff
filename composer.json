{
    "name": "dcardenasl/ci4-bff-starter",
    "description": "CodeIgniter 4 Backend-for-Frontend Starter \u2014 stateless gateway over a ci4-api-starter hub and one or more ci4-domain-starter apps.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "dcardenasl/ci4-api-core": "^1.0",
        "monolog/monolog": "^3.5",
        "sentry/sentry": "^4.6",
        "zircote/swagger-php": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mikey179/vfsstream": "^1.6",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1.56",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "chmod +x pre-commit",
            "[ -d .git/hooks ] && cp pre-commit .git/hooks/pre-commit || true",
            "chmod +x pre-push",
            "[ -d .git/hooks ] && cp pre-push .git/hooks/pre-push || true"
        ],
        "post-update-cmd": [
            "chmod +x pre-commit",
            "[ -d .git/hooks ] && cp pre-commit .git/hooks/pre-commit || true",
            "chmod +x pre-push",
            "[ -d .git/hooks ] && cp pre-push .git/hooks/pre-push || true"
        ],
        "test:unit": "phpunit --testsuite=Unit --configuration=phpunit.xml --no-coverage --testdox",
        "test:feature": "phpunit --testsuite=Feature --configuration=phpunit.xml --no-coverage --testdox",
        "test": "phpunit --configuration=phpunit.xml --no-coverage --testdox",
        "test:coverage": "phpunit --configuration=phpunit.xml --testdox",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff --sequential",
        "arch-drift": "phpunit tests/Unit/Architecture --configuration=phpunit.xml --no-coverage --testdox",
        "swagger:generate": "php spark swagger:generate",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@arch-drift",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
